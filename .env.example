# Copy to .env.local and fill in. .env.local is gitignored — never commit a real token.

# Whapi.cloud gateway (hackathon demo path).
# NOTE: Whapi drives a real WhatsApp session. It is fast to demo but carries a ban risk on the
# number and is NOT a production path for a government deployment — that is Meta's Business
# Cloud API. Keep the client interface identical so the gateway can be swapped.
WHAPI_BASE_URL=https://gate.whapi.cloud
WHAPI_TOKEN=

# Shared secret appended to the webhook URL as ?secret=… ; callbacks without it are rejected.
WHATSAPP_WEBHOOK_SECRET=

# Vertex AI — narration only. The model NEVER computes a number; see src/lib/ai/narrate.ts.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/vertex-sa.json
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.0-flash

# ── Voice ──────────────────────────────────────────────────────────────────
# Either provider serves; Sarvam is picked first when both are present.

# Sarvam AI — one key from dashboard.sarvam.ai, free starting credit, no billing account.
# Indic-first models, and an Indian model stack is a real pitch line for a government submission.
SARVAM_API_KEY=

# Bhashini (ULCA) — the Government of India's own stack. Right long-term answer for a ministry
# deployment, but needs ULCA onboarding rather than a signup form.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
